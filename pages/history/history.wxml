<!-- pages/history/history.wxml -->
<view class="page">
  <view class="header">
    <text class="title">订单记录</text>
    <view class="header-actions">
      <text class="action-btn" bindtap="clearAll" wx:if="{{!isEmpty}}">清空全部</text>
    </view>
  </view>

  <view wx:if="{{!isEmpty}}" class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-summary" bindtap="toggleDetail" data-id="{{item.id}}">
        <view class="order-left">
          <text class="order-time">{{item.timeStr}}</text>
          <text class="order-items">{{item.itemsStr}}</text>
        </view>
        <view class="order-right">
          <text class="order-total">¥{{item.total}}</text>
          <text class="order-status {{item.status === '已取消' ? 'cancelled' : ''}}">{{item.status}}</text>
          <text class="order-arrow">{{item.showDetail ? '收起' : '展开'}}</text>
        </view>
      </view>

      <view wx:if="{{item.showDetail}}" class="order-detail">
        <view wx:for="{{item.items}}" wx:key="id" class="detail-row">
          <text class="detail-name">{{item.name}}</text>
          <text class="detail-qty">×{{item.qty}}</text>
          <text class="detail-price">¥{{item.subtotal}}</text>
        </view>
        <view class="detail-total">
          <text>合计</text>
          <text class="detail-total-price">¥{{item.total}}</text>
        </view>
        <view class="detail-actions">
          <button class="detail-btn delete" bindtap="deleteOrder" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-emoji">📋</text>
    <text class="empty-title">暂无订单记录</text>
    <text class="empty-desc">去菜单点几道菜，提交后\n订单就会出现在这里</text>
    <button class="menu-btn" bindtap="goBack">返回</button>
  </view>
</view>
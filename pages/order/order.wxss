/** pages/order/order.wxss **/
.page { min-height: 100vh; position: relative; padding-bottom: 0; }

/* 角色切换按钮 */
.role-switch {
  position: fixed; top: 20rpx; right: 30rpx; z-index: 200;
  background: rgba(44,36,22,0.72); color: #fff;
  font-size: 22rpx; padding: 10rpx 24rpx; border-radius: 999rpx; font-weight: 500;
}

.header { display: flex; align-items: center; padding: 64rpx 30rpx 16rpx; }
.header .title { font-size: 40rpx; font-weight: 700; color: #2c2416; margin-right: 16rpx; }
.header .subtitle { font-size: 24rpx; color: #8a7e6e; flex: 1; }
.header-actions { display: flex; gap: 20rpx; }
.action-btn { font-size: 24rpx; color: #8a7e6e; padding: 4rpx; }

/* 购物车 */
.cart-list { padding: 0 30rpx; }
.cart-item { display: flex; align-items: center; background: #fff; border: 2rpx solid #e8e0d6; border-radius: 20rpx; padding: 16rpx; margin-bottom: 16rpx; }
.cart-img { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: linear-gradient(135deg,#fce8e7,#fdf4f0); display: flex; align-items: center; justify-content: center; font-size: 40rpx; overflow: hidden; flex-shrink: 0; margin-right: 18rpx; }
.cart-img image { width: 100%; height: 100%; display: block; }
.cart-info { flex: 1; }
.cart-name { display: block; font-size: 28rpx; font-weight: 600; }
.cart-price { display: block; font-size: 22rpx; color: #8a7e6e; margin-top: 4rpx; }
.qty-control { display: flex; align-items: center; gap: 8rpx; }
.qty-btn { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid #e8e0d6; display: flex; align-items: center; justify-content: center; font-size: 28rpx; line-height: 1; }
.qty-btn.minus { background: #faf6f0; }
.qty-btn.plus { background: #c73e3a; color: #fff; border-color: #c73e3a; }
.qty-num { font-size: 28rpx; font-weight: 600; min-width: 40rpx; text-align: center; }
.qty-subtotal { font-size: 26rpx; font-weight: 600; color: #c73e3a; margin-left: 8rpx; min-width: 100rpx; text-align: right; }

.cart-footer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; background: #fff; border-top: 2rpx solid #e8e0d6; padding: 16rpx 30rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 100; }
.footer-left { flex: 1; }
.footer-qty { display: block; font-size: 22rpx; color: #8a7e6e; }
.footer-total { display: block; font-size: 32rpx; font-weight: 700; color: #c73e3a; margin-top: 4rpx; }
.submit-btn { background: #c73e3a; color: #fff; font-size: 28rpx; font-weight: 600; padding: 18rpx 40rpx; border-radius: 999rpx; border: none; line-height: 1; }
.submit-btn::after { border: none; }

.empty-state { text-align: center; padding: 120rpx 40rpx 0; }
.empty-emoji { display: block; font-size: 96rpx; margin-bottom: 20rpx; }
.empty-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.empty-desc { display: block; font-size: 26rpx; color: #8a7e6e; margin-bottom: 32rpx; }
.menu-btn { background: #c73e3a; color: #fff; font-size: 28rpx; padding: 18rpx 60rpx; border-radius: 999rpx; border: none; }
.menu-btn::after { border: none; }

/* 厨师视图 */
.chef-order-list { padding: 0 30rpx; }
.chef-order-card { background: #fff; border: 2rpx solid #e8e0d6; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.chef-order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.chef-order-time { font-size: 24rpx; color: #8a7e6e; }
.chef-order-status { font-size: 22rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 999rpx; }
.chef-order-status.pending { background: #fce8e7; color: #c73e3a; }
.chef-order-status.cooking { background: #fff3e0; color: #e65100; }
.chef-order-status.done { background: #e8f5e9; color: #2e7d32; }
.chef-dish-row { padding: 6rpx 0; }
.chef-dish-name { font-size: 28rpx; color: #2c2416; }
.chef-dish-qty { font-size: 24rpx; color: #8a7e6e; }
.chef-order-total { font-size: 26rpx; color: #c73e3a; font-weight: 600; margin-top: 8rpx; margin-bottom: 16rpx; }
.chef-actions { display: flex; gap: 16rpx; border-top: 2rpx solid #f5f0ea; padding-top: 16rpx; }
.chef-order-list { padding: 0 30rpx; }
.chef-dish-card { background: #fff; border: 2rpx solid #e8e0d6; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.chef-dish-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.chef-dish-name { font-size: 30rpx; font-weight: 600; color: #2c2416; }
.chef-dish-qty { font-size: 24rpx; color: #c73e3a; font-weight: 600; }
.chef-order-status { margin-left: auto; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx; }
.chef-order-status.pending { background: #fff3e0; color: #e65100; }
.chef-order-status.cooking { background: #e3f2fd; color: #1976d2; }
.chef-order-status.done { background: #e8f5e9; color: #2e7d32; }
.chef-dish-time { font-size: 22rpx; color: #8a7e6e; margin-bottom: 12rpx; }
.chef-actions { display: flex; gap: 12rpx; }
.chef-btn { flex: 1; font-size: 26rpx; font-weight: 600; padding: 14rpx 0; border-radius: 999rpx; border: none; line-height: 1; }
.chef-btn.cooking { background: #e65100; color: #fff; }
.chef-btn.done { background: #2e7d32; color: #fff; }
.chef-done-label { font-size: 24rpx; color: #8a7e6e; }

/* 厨师确认按钮 */
.chef-confirm-bar {
  margin: 20rpx 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #c73e3a, #a1302a);
  border-radius: 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.chef-confirm-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.chef-confirm-hint {
  font-size: 22rpx;
  color: #ffd700;
  font-weight: 500;
}
.unconfirmed-tip {
  margin: 16rpx 30rpx;
  padding: 20rpx;
  background: #fff8e6;
  border: 2rpx solid #ffd700;
  border-radius: 12rpx;
  text-align: center;
}
.unconfirmed-text {
  font-size: 24rpx;
  color: #8a6914;
}
/* 取消厨师按钮 */
.chef-cancel-bar {
  margin: 12rpx 30rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
}
.chef-cancel-text {
  font-size: 24rpx;
  color: #666;
}

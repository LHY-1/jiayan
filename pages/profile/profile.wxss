/** pages/profile/profile.wxss **/
.page {
  min-height: 100vh;
  padding-bottom: 0;
}

.header {
  padding: 28rpx 30rpx 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c2416;
  line-height: 1.2;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 6rpx;
}

.content {
  padding: 0 30rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2416;
}

.user-hint {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 4rpx;
}

.nickname-row {
  padding: 20rpx 0;
}

.nickname-component {
  width: 100%;
}

/* 家庭卡片 */
.family-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.family-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #fce8e7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.family-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.family-meta {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 4rpx;
}

/* 区块 */
.section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-bottom: 16rpx;
}

/* 设置卡片 */
.settings-card {
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 20rpx;
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #e8e0d6;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
}

/* 菜单行 */
.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #e8e0d6;
  font-size: 28rpx;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #8a7e6e;
  font-size: 26rpx;
}
/* 昵称设置按钮 */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.nickname-btn, .save-btn {
  flex-shrink: 0;
  background: #c73e3a;
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.save-btn {
  background: #2c2416;
}

.btn-text {
  color: #fff;
}

.nickname-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #faf6f0;
  border: 2rpx solid #e8e0d6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2c2416;
}

/* 昵称设置 - 使用 button open-type */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 20rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  border: none;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
  background: transparent;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-input {
  flex: 1;
  height: 120rpx;
  padding: 0 24rpx;
  background: #faf6f0;
  border: 2rpx solid #e8e0d6;
  border-radius: 60rpx;
  font-size: 30rpx;
  color: #2c2416;
}

/* 昵称设置 - 使用 button open-type */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 20rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  border: none;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
  background: transparent;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: #faf6f0;
  border: 2rpx solid #e8e0d6;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
}

.get-nickname-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.get-nickname-btn::after {
  border: none;
  background: transparent;
}

.get-nickname-btn .btn-text {
  font-size: 24rpx;
  color: #c73e3a;
  text-decoration: underline;
}

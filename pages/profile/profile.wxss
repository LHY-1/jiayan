/** pages/profile/profile.wxss **/
.page {
  min-height: 100vh;
  padding-bottom: 0;
}

.header {
  padding: 28rpx 30rpx 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c2416;
  line-height: 1.2;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 6rpx;
}

.content {
  padding: 0 30rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
}

.avatar-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  border: none;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
  background: transparent;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2416;
}

.user-hint {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 4rpx;
}

/* 区块 */
.section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-bottom: 16rpx;
}

/* 设置卡片 */
.settings-card {
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 20rpx;
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #e8e0d6;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
}

/* 菜单行 */
.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #e8e0d6;
  font-size: 28rpx;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #8a7e6e;
  font-size: 26rpx;
}

/* 昵称设置 */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2416;
  padding: 12rpx 0;
}

.save-btn {
  font-size: 26rpx;
  color: #c73e3a;
  padding: 12rpx 24rpx;
  border: 2rpx solid #c73e3a;
  border-radius: 32rpx;
  flex-shrink: 0;
}

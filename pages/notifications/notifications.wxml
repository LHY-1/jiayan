<!-- pages/notifications/notifications.wxml -->
<view class="page">
  <view class="header">
    <text class="title">通知中心</text>
    <view class="header-actions">
      <text class="action-btn" bindtap="markAllRead" wx:if="{{unreadCount > 0}}">全部已读</text>
      <text class="action-btn" bindtap="clearAll" wx:if="{{!isEmpty}}">清空</text>
    </view>
  </view>

  <view wx:if="{{!isEmpty}}" class="notif-list">
    <view wx:for="{{notifications}}" wx:key="id" class="notif-card {{item.read ? '' : 'unread'}}" bindtap="markRead" data-id="{{item.id}}">
      <view class="notif-dot" wx:if="{{!item.read}}"></view>
      <view class="notif-content">
        <text class="notif-title">{{item.title}}</text>
        <text class="notif-body">{{item.content}}</text>
        <text class="notif-time">{{item.timeStr}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-emoji">🔔</text>
    <text class="empty-title">暂无通知</text>
    <text class="empty-desc">提交点单后，通知会出现在这里</text>
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>
</view>
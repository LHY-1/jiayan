/** pages/random/random.wxss **/
.page {
  min-height: 100vh;
  padding-bottom: 0;
}

.header {
  padding: 28rpx 30rpx 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c2416;
  line-height: 1.2;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 6rpx;
}

.content {
  padding: 0 30rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: #c73e3a;
  border-radius: 24rpx;
  text-align: center;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.star-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.welcome-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.welcome-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* 区块 */
.section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-bottom: 16rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8a7e6e;
}

.chip.selected {
  background: #fce8e7;
  border-color: #c73e3a;
  color: #c73e3a;
}

/* 主按钮 */
.primary-btn {
  width: 100%;
  height: 96rpx;
  background: #c73e3a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0 0 30rpx 0;
  padding: 0;
}

.primary-btn::after {
  border: none;
}

.primary-btn[disabled] {
  opacity: 0.6;
}

.loading-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 结果卡片 */
.combo-result {
  background: #ffffff;
  border: 2rpx solid #e8e0d6;
  border-radius: 24rpx;
  padding: 30rpx;
  animation: fadeUp 0.5s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.combo-header {
  text-align: center;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #e8e0d6;
}

.combo-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.combo-sub {
  display: block;
  font-size: 24rpx;
  color: #8a7e6e;
  margin-top: 6rpx;
}

.combo-dish {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #e8e0d6;
}

.combo-dish:last-of-type {
  border-bottom: none;
}

.combo-emoji {
  width: 60rpx;
  height: 60rpx;
  background: #fce8e7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.combo-info {
  flex: 1;
}

.combo-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.combo-cat {
  display: block;
  font-size: 22rpx;
  color: #8a7e6e;
  margin-top: 4rpx;
}

.combo-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #c73e3a;
}

.combo-footer {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  padding-top: 24rpx;
  border-top: 2rpx solid #e8e0d6;
  margin-top: 8rpx;
}

.retry-btn {
  flex: 1;
  background: transparent;
  border: 2rpx solid #e8e0d6;
  border-radius: 999rpx;
  color: #2c2416;
  font-size: 26rpx;
  padding: 16rpx 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.retry-btn::after {
  border: none;
}

.add-cart-btn {
  flex: 1;
  background: #c73e3a;
  border: none;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.add-cart-btn::after {
  border: none;
}